---
import type { IndicatorUnit } from '../../lib/data';
import { formatValue } from '../../lib/format';

interface Props {
  value: number | null | undefined;
  unit?: IndicatorUnit | 'raw';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  fractionDigits?: number;
  class?: string;
}

const {
  value,
  unit = 'percent',
  size = 'md',
  fractionDigits = 2,
  class: extraClass = '',
} = Astro.props;

const sizeClass = {
  sm: 'text-base',
  md: 'text-2xl',
  lg: 'text-4xl',
  xl: 'text-6xl',
}[size];

const formatted = formatValue(value, unit, fractionDigits);
---

<span class={`font-display font-semibold tabular-nums ${sizeClass} ${extraClass}`}>
  {formatted}
</span>
