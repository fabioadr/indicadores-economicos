---
interface Props {
  caption?: string;
  class?: string;
}

const { caption, class: extraClass = '' } = Astro.props;
---

<div class={`overflow-x-auto border border-border rounded-md bg-bg-elevated ${extraClass}`}>
  <table class="w-full text-sm font-mono tabular-nums">
    {caption && <caption class="sr-only">{caption}</caption>}
    <slot />
  </table>
</div>

<style is:global>
  table thead th {
    text-align: right;
    padding: 0.75rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in oklab, var(--color-bg) 60%, transparent);
  }
  table thead th:first-child,
  table tbody td:first-child,
  table tbody th:first-child {
    text-align: left;
  }
  table tbody td,
  table tbody th {
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--color-border);
    font-weight: 400;
    text-align: right;
  }
  table tbody tr:last-child td,
  table tbody tr:last-child th {
    border-bottom: 0;
  }
</style>
