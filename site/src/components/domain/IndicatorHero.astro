---
import type { IndicatorDetail } from '../../lib/data';
import CategoryPill from '../ui/CategoryPill.astro';
import ValueDisplay from '../ui/ValueDisplay.astro';
import { formatDateLong, formatMonthYear, formatPercent } from '../../lib/format';

interface Props {
  indicator: IndicatorDetail;
}

const { indicator } = Astro.props;
const { latest, frequency } = indicator;
const refLabel = frequency === 'monthly'
  ? formatMonthYear(latest.reference_date)
  : formatDateLong(latest.reference_date);
---

<section class="space-y-6">
  <div class="flex flex-wrap items-center gap-3">
    <CategoryPill category={indicator.category} asLink />
    <span class="text-xs uppercase tracking-wide text-ink-faint font-mono">
      {indicator.code}
    </span>
  </div>
  <h1 class="font-display text-3xl md:text-4xl font-semibold text-ink leading-tight">
    {indicator.name}
  </h1>
  <p class="text-base text-ink-muted leading-relaxed max-w-3xl">
    {indicator.short_description}
  </p>

  <div class="bg-bg-elevated border border-border rounded-lg p-6 md:p-8 grid gap-6 md:grid-cols-[auto_1fr] md:items-center">
    <div>
      <p class="text-xs uppercase tracking-wide text-ink-faint mb-2">
        Último valor — {refLabel}
      </p>
      <ValueDisplay value={latest.value} size="xl" />
    </div>
    <dl class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6 text-sm md:border-l md:border-border md:pl-8">
      <div>
        <dt class="uppercase tracking-wide text-ink-faint text-xs mb-1">Acumulado no ano</dt>
        <dd class="font-mono tabular-nums text-ink text-base">{formatPercent(latest.ytd)}</dd>
      </div>
      <div>
        <dt class="uppercase tracking-wide text-ink-faint text-xs mb-1">12 meses</dt>
        <dd class="font-mono tabular-nums text-ink text-base">{formatPercent(latest.last_12m)}</dd>
      </div>
      {latest.last_24m !== undefined && latest.last_24m !== null && (
        <div>
          <dt class="uppercase tracking-wide text-ink-faint text-xs mb-1">24 meses</dt>
          <dd class="font-mono tabular-nums text-ink text-base">{formatPercent(latest.last_24m)}</dd>
        </div>
      )}
    </dl>
  </div>
</section>
