---
import type { WageHighlights } from '../../lib/data';
import { formatPercent, formatValue } from '../../lib/format';

interface Props {
  highlights: WageHighlights;
}

const { highlights } = Astro.props;
const adjustment = formatAdjustment(highlights.adjustment_brl, highlights.adjustment_pct);
const previous =
  highlights.previous_value === null
    ? null
    : formatValue(highlights.previous_value, 'brl');

function formatAdjustment(brl: number | null, pct: number | null): string {
  if (brl === null || pct === null) return '—';
  const sign = brl > 0 ? '+' : '';
  return `${sign}${formatValue(brl, 'brl')} (${sign}${formatPercent(pct)})`;
}
---

<section class="space-y-3">
  <h2 class="font-display text-xl font-semibold text-ink">Valor vigente</h2>
  <dl class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <div class="bg-bg-elevated border border-border rounded-lg p-4">
      <dt class="uppercase tracking-wide text-ink-faint text-xs mb-1">Mensal</dt>
      <dd class="font-mono tabular-nums text-ink text-lg">{formatValue(highlights.monthly, 'brl')}</dd>
    </div>
    <div class="bg-bg-elevated border border-border rounded-lg p-4">
      <dt class="uppercase tracking-wide text-ink-faint text-xs mb-1">Diário</dt>
      <dd class="font-mono tabular-nums text-ink text-lg">{formatValue(highlights.daily, 'brl')}</dd>
      <p class="text-xs text-ink-faint mt-1">base {highlights.day_divisor} dias</p>
    </div>
    <div class="bg-bg-elevated border border-border rounded-lg p-4">
      <dt class="uppercase tracking-wide text-ink-faint text-xs mb-1">Por hora</dt>
      <dd class="font-mono tabular-nums text-ink text-lg">{formatValue(highlights.hourly, 'brl')}</dd>
      <p class="text-xs text-ink-faint mt-1">base {highlights.hour_divisor} horas</p>
    </div>
    <div class="bg-bg-elevated border border-border rounded-lg p-4">
      <dt class="uppercase tracking-wide text-ink-faint text-xs mb-1">Reajuste do último degrau</dt>
      <dd class="font-mono tabular-nums text-ink text-lg">{adjustment}</dd>
      {previous && <p class="text-xs text-ink-faint mt-1">sobre {previous}</p>}
    </div>
  </dl>
</section>
