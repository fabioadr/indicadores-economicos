---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import interLatin400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import frauncesLatin600 from '@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const { title, description, ogType = 'website', jsonLd } = Astro.props;

const SITE_NAME = 'Indicadores Econômicos Hoje';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const ADSENSE_CLIENT = 'ca-pub-4818547367233910';
const FB_PIXEL_ID = '422346052570729';
const GA4_MEASUREMENT_ID = 'G-3DL97SS1JR';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preload" href={interLatin400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesLatin600} as="font" type="font/woff2" crossorigin />
    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <script
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`}
    />
    <script is:inline define:vars={{ GA4_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', GA4_MEASUREMENT_ID);
    </script>
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
      crossorigin="anonymous"
    />
    <script is:inline define:vars={{ FB_PIXEL_ID }}>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', FB_PIXEL_ID);
      fbq('track', 'PageView');
    </script>
  </head>
  <body class="bg-bg text-ink">
    <noscript>
      <img
        height="1"
        width="1"
        style="display: none"
        alt=""
        src={`https://www.facebook.com/tr?id=${FB_PIXEL_ID}&ev=PageView&noscript=1`}
      />
    </noscript>
    <Header />
    <main class="max-w-[1100px] mx-auto px-6 py-12 md:py-16">
      <slot />
    </main>
    <Footer />
    <style is:global>
      a { text-decoration: underline; text-underline-offset: 3px; }
      a.no-underline { text-decoration: none; }
      h1, h2, h3 { font-family: var(--font-display); }
      .prose h2 {
        font-size: 1.5rem;
        font-weight: 600;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
      }
      .prose p { margin-bottom: 1rem; line-height: 1.7; }
      .prose ul { list-style: disc; padding-left: 1.5rem; margin-bottom: 1rem; }
      .prose li { margin-bottom: 0.25rem; line-height: 1.7; }
      .prose strong { font-weight: 600; color: var(--color-ink); }
    </style>
  </body>
</html>
