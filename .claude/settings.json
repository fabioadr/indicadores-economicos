{
  "logLevel": "debug",
  "verbose": true,
  "skills": {
    "enabled": true,
    "conditional": true,
    "autoload": []
  },
  "permissions": {
    "allow": [
      "mcp__sqlite",
      "mcp__context7",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",

      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(chmod:*)",

      "Bash(.venv/bin/python *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/pip *)",
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(ruff:*)",

      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(pnpm:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",

      "Bash(make:*)",
      "Bash(bash scripts/*)",
      "Bash(./scripts/*)",

      "Read(*)",
      "Write(pipeline/**)",
      "Write(site/**)",
      "Write(scripts/**)",
      "Write(data/**)",
      "Write(docs/**)",
      "Write(.claude/**)",
      "Write(.gitignore)",
      "Write(.env.example)",
      "Write(README.md)",
      "Write(Makefile)",
      "Write(vercel.json)",
      "Write(astro.config.mjs)",
      "Write(tailwind.config.mjs)",
      "Write(package.json)",
      "Write(package-lock.json)",
      "Write(requirements.txt)",
      "Write(tsconfig.json)",

      "WebFetch(domain:api.bcb.gov.br)",
      "WebFetch(domain:dadosabertos.bcb.gov.br)",
      "WebFetch(domain:docs.astro.build)",
      "WebFetch(domain:docs.python-telegram-bot.org)",
      "WebFetch(domain:matplotlib.org)",
      "WebFetch(domain:python-bcb.readthedocs.io)",
      "WebFetch(domain:servicodados.ibge.gov.br)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:www3.bcb.gov.br)",
      "WebSearch"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git commit --amend:*)",
      "Bash(git clean:*)",
      "Bash(crontab:*)",
      "Bash(systemctl:*)",
      "Bash(loginctl:*)",
      "Read(.venv/**)",
      "Read(venv/**)",
      "Write(.env)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(wget * | bash:*)",
      "Bash(eval:*)",
      "Read(./.env)",
      "Read(./pipeline/.env)",
      "Read(**/*secret*)",
      "Read(**/*token*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(node_modules/**)",
      "Read(**/__pycache__/)",
      "Read(pipeline/logs/)",
      "Read(*.log)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git push.*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo '\u26a0\ufe0f git push pendente. Isso vai disparar deploy na Vercel. Confirme antes de aprovar.'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(python3 -c \"import json,sys; d=json.load(sys.stdin); print(d.get('tool_input',d).get('command',''))\" 2>/dev/null || true); case \"$CMD\" in *grep*|*rg\\ *|*ripgrep*|*find\\ *|*fd\\ *|*ack\\ *|*ag\\ *)   [ -f graphify-out/graph.json ] &&   echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.\"}}'   || true ;; esac"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f data/indicadores.db && echo 'DB ok' || echo 'DB n\u00e3o iniciado'"
          }
        ]
      }
    ]
  }
}
