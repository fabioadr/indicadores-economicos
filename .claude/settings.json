{
  "logLevel": "info",
  "verbose": true,
  "permissions": {
    "allow": [
      "mcp__sqlite",
      "mcp__context7",
      "mcp__github__get_file_contents",
      "mcp__github__list_issues",
      "mcp__github__get_issue",
      "mcp__github__create_issue",
      "mcp__github__list_commits",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",

      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(chmod:*)",

      "Bash(.venv/bin/python *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/pip *)",
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(ruff:*)",
      "Bash(source:*)",
      "Bash(. .venv/bin/activate:*)",

      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(pnpm:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",

      "Bash(sqlite3:*)",

      "Bash(make:*)",
      "Bash(bash scripts/*)",
      "Bash(./scripts/*)",

      "Read(*)",
      "Write(pipeline/**)",
      "Write(site/**)",
      "Write(scripts/**)",
      "Write(data/**)",
      "Write(docs/**)",
      "Write(.claude/**)",
      "Write(.gitignore)",
      "Write(.env.example)",
      "Write(README.md)",
      "Write(Makefile)",
      "Write(vercel.json)",
      "Write(astro.config.mjs)",
      "Write(tailwind.config.mjs)",
      "Write(package.json)",
      "Write(package-lock.json)",
      "Write(requirements.txt)",
      "Write(tsconfig.json)",

      "WebFetch(domain:api.bcb.gov.br)",
      "WebFetch(domain:dadosabertos.bcb.gov.br)",
      "WebFetch(domain:www3.bcb.gov.br)",
      "WebFetch(domain:docs.astro.build)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:docs.python-telegram-bot.org)",
      "WebFetch(domain:python-bcb.readthedocs.io)",
      "WebFetch(domain:matplotlib.org)",
      "WebSearch"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git commit --amend:*)",
      "Bash(git clean:*)",
      "Bash(crontab:*)",
      "Bash(systemctl:*)",
      "Bash(loginctl:*)",
      "Write(.env)",

      "mcp__github__create_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__delete_file"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(wget * | bash:*)",
      "Bash(eval:*)",
      "Read(./.env)",
      "Read(./pipeline/.env)",
      "Read(**/*secret*)",
      "Read(**/*token*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(node_modules/**)",
      "Read(**/dist/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git push.*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo '⚠️ git push pendente. Isso vai disparar deploy na Vercel. Confirme antes de aprovar.'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f data/indicadores.db && echo 'DB ok' || echo 'DB não iniciado'"
          }
        ]
      }
    ]
  }
}
