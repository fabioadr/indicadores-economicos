      "Bash(awk:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(command -v *)",
      "Bash(type:*)",
      "Bash(readlink:*)",
      "Bash(realpath:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(date:*)",
      "Bash(uptime:*)",
      "Bash(whoami)",
      "Bash(id:*)",
      "Bash(ps:*)",
      "Bash(pgrep:*)",
      "Bash(free:*)",
      "Bash(test:*)",
      "Bash(true)",
      "Bash(sleep:*)",
      "Bash(mountpoint:*)",
      "Bash(findmnt:*)",
      "Bash(lsblk:*)",
      "Bash(sqlite3 -readonly *)",
      "Bash(gzip -c *)",
      "Bash(bash -n *)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(chmod:*)",
      "Bash(.venv/bin/python *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/ruff *)",
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote -v)",
      "Bash(git branch:*)",
      "Bash(git tag -l*)",
      "Bash(git describe:*)",
      "Bash(git config --get *)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git push --dry-run*)",
      "Bash(make:*)",
      "Bash(bash scripts/*)",
      "Bash(./scripts/*)",
      "Bash(bash .claude/*)",
      "Bash(graphify:*)",
      "Bash(systemctl --user status *)",
      "Bash(systemctl --user is-active *)",
      "Bash(systemctl --user restart indicadores-bot*)",
      "Bash(journalctl --user *)",
      "Bash(crontab -l)",
      "Edit(pipeline/**)",
      "Edit(site/**)",
      "Edit(scripts/**)",
      "Edit(tests/**)",
      "Edit(docs/**)",
      "Edit(.claude/**)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(README.md)",
      "Edit(Makefile)",
      "Edit(.gitignore)",
      "WebFetch(domain:api.bcb.gov.br)",
      "WebFetch(domain:dadosabertos.bcb.gov.br)",
      "WebFetch(domain:www3.bcb.gov.br)",
      "WebFetch(domain:python-bcb.readthedocs.io)",
      "WebFetch(domain:servicodados.ibge.gov.br)",
      "WebFetch(domain:sidra.ibge.gov.br)",
      "WebFetch(domain:apisidra.ibge.gov.br)",
      "WebFetch(domain:docs.astro.build)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:docs.python-telegram-bot.org)",
      "WebFetch(domain:matplotlib.org)",
      "WebFetch(domain:docs.astral.sh)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)",
      "Bash(sudo:*)",
      "Edit(.env)",
      "Edit(pipeline/.env)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(eval:*)",
      "Read(./.env)",
      "Read(./pipeline/.env)",
      "Read(**/.env)",
      "Read(./pipeline/secrets/**)",
      "Edit(./pipeline/secrets/**)",
      "Read(**/*secret*)",
      "Read(**/*token*)",
      "Read(**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(**/node_modules/**)",
      "Read(**/__pycache__/)",
      "Read(pipeline/logs/)",
      "Read(*.log)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-health.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bash_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__sqlite__write_query",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sqlite_write_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(python3 -c \"import json,sys; d=json.load(sys.stdin); print(d.get('tool_input',d).get('command',''))\" 2>/dev/null || true); case \"$CMD\" in *grep*|*rg\\ *|*ripgrep*|*find\\ *|*fd\\ *|*ack\\ *|*ag\\ *)   [ -f graphify-out/graph.json ] &&   echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.\"}}'   || true ;; esac"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/js_budget.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
